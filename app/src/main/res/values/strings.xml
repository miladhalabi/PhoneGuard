    <!-- Senders -->
    <string name="senders_any">Any number</string>
    <string name="senders_trusted">Trusted only</string>
    <string name="trusted_intro">Alerts are sent to these numbers. Add your second phone or someone you trust.</string>
    <string name="senders_label">Accept commands from</string>
    <string name="senders_any_help">Anyone who knows your PIN can send commands. Easiest if you lose your phone and have to borrow one.</string>
    <string name="senders_trusted_help">Only the numbers above are accepted, even with the right PIN. Safer, because the command (and your PIN) stays visible in the stolen phone\'s messages.</string>
    <string name="senders_empty">No numbers yet. Add at least one to receive alerts.</string>
    <string name="add_number_hint">Phone number</string>
    <string name="cd_add_number">Add number</string>
    <string name="pick_contact">Pick from contacts</string>
    <string name="err_number_invalid">Enter a full phone number</string>
    <string name="err_number_duplicate">Already in the list</string>
    <string name="msg_number_removed">Removed %1$s</string>
    <string name="undo">Undo</string>

    <!-- Commands -->
    <string name="cmd_loc">LOC 1234</string>
    <string name="cmd_loc_desc">Replies with a Google Maps link, accuracy and battery level</string>
    <string name="cmd_lock">LOCK 1234</string>
    <string name="cmd_lock_desc">Locks the screen</string>
    <string name="lock_reply_label">Reply to LOCK</string>
    <string name="lock_reply_none">No reply</string>
    <string name="lock_reply_locked">Locked</string>
    <string name="lock_reply_location">Location</string>
    <string name="cmd_alarm">ALARM 1234</string>
    <string name="cmd_alarm_desc">Locks the screen and rings at full volume for 3 minutes, even on silent. Stops when the phone is unlocked.</string>
    <string name="cmd_stop">STOP 1234</string>
    <string name="cmd_stop_desc">Stops the alarm and tracking, and ends lost mode</string>
    <string name="cmd_track">TRACK 1234</string>
    <string name="cmd_track_desc">Texts the location every 10 minutes for 2 hours</string>
    <string name="cmd_call">CALL 1234</string>
    <string name="cmd_call_desc">The phone calls you back, so you can hear what\'s around it</string>
    <string name="cmd_info">INFO 1234</string>
    <string name="cmd_info_desc">Battery, SIM, network, and whether lost mode or tracking is on</string>
    <string name="cmd_footnote">Replace 1234 with your PIN. Arabic works too: ⁨موقع⁩, ⁨قفل⁩, ⁨صفارة⁩, ⁨وقف⁩, ⁨تتبع⁩, ⁨اتصل⁩, ⁨معلومات⁩. Wrong PINs get no reply, and 5 wrong tries pause commands for 30 minutes.</string>

    <!-- Alerts -->
    <string name="alert_sim">New SIM inserted</string>
    <string name="alert_sim_desc">Texts your trusted numbers from the new SIM, so you see its number, plus the location</string>
    <string name="alert_unlock">Wrong unlock attempts</string>
    <string name="alert_unlock_desc">After 3 wrong PIN or pattern tries, texts your trusted numbers the location</string>
    <string name="alert_battery">Battery about to die</string>
    <string name="alert_battery_desc">In lost mode, texts one last location when the battery drops to 10%</string>

