    <!-- Status card -->
    <string name="hero_done_title">You\'re protected</string>
    <string name="hero_done_any">Text LOC and your PIN to this phone from any phone to find it.</string>
    <string name="hero_done_trusted">Text LOC and your PIN to this phone from a trusted number to find it.</string>
