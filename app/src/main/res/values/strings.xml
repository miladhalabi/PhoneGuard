    <string name="step_background">Location all the time</string>
    <string name="step_background_desc">Choose \"Allow all the time\" so it works with the screen off</string>
    <string name="step_admin">Lock permission</string>
    <string name="step_admin_desc">Lets a command lock the screen and spot wrong unlock attempts</string>
    <string name="step_battery">Battery optimization</string>
    <string name="step_battery_desc">Stops the system from putting the app to sleep</string>
    <string name="step_screen_lock">Screen lock</string>
    <string name="step_screen_lock_desc">Set a PIN or pattern, otherwise locking does nothing</string>
    <string name="step_autostart">Autostart</string>
    <string name="step_autostart_desc">Xiaomi blocks apps without it. Turn it on for Phone Guard. Can\'t be checked automatically.</string>
    <string name="step_fullscreen">Lost screen</string>
    <string name="step_fullscreen_desc">Lets the lost message appear over the lock screen</string>
